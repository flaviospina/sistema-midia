# =====================================================================
# Envio de Mídias ADMoema — configuração
# Copie este arquivo para ".env" (na mesma pasta) e preencha.
# =====================================================================

# production | development (development mostra erros na tela)
APP_ENV=production
APP_NAME="Envio de Mídias ADMoema"

# URL pública completa, sem barra no final
BASE_URL=https://admoema.com.br/envio_midias

# Chave para cifrar os tokens das redes sociais: 64 caracteres hexadecimais.
# Gere em https://www.random.org/bytes/ (32 bytes, hex) ou com: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# Banco de dados (cPanel → Bancos de dados MySQL). Recomendado: um banco só para este sistema.
# Todas as tabelas têm o prefixo em_, então também funciona num banco já usado por outro sistema.
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# Sessão (nome próprio: o login deste sistema não se mistura com o de outros sistemas do site)
SESSION_NAME=ENVIO_SID
SESSION_COOKIE_PATH=/
SESSION_COOKIE_DOMAIN=
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# Login: bloqueio por tentativas (e-mail+IP na janela) e por IP por hora
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_IP_MAX_PER_HOUR=30

# 2ª etapa por código no e-mail: desligado | opcional (cada pessoa liga em Meus dados) | equipe (obrigatório para admin/fotógrafo/social) | todos
TWO_FACTOR_MODE=opcional
TWO_FACTOR_CODE_MINUTES=10
# Dias em que um aparelho marcado como confiável dispensa o código
TRUSTED_DEVICE_DAYS=30
PASSWORD_RESET_MINUTES=60

# Armazenamento. Vazio = pasta storage/ dentro de envio_midias (protegida por .htaccess).
# Para guardar fora da pasta pública, informe o caminho completo, ex.: /home/USUARIO/envio_midias_storage
STORAGE_PATH=
# Envio em pedaços (MB por pedaço) e tamanho máximo por foto (MB)
UPLOAD_CHUNK_MB=2
UPLOAD_MAX_MB=80
UPLOAD_SESSION_HOURS=24
# Lado maior da versão de exibição (o original é preservado)
DISPLAY_MAX_SIDE=2048
STORAGE_ALERT_GB=40

# Redes sociais (Meta Graph API) — cada pessoa conecta a própria conta em Meus dados
META_GRAPH_VERSION=v21.0
# Minutos de validade do link temporário que a Meta usa para baixar a foto
PUBLIC_LINK_MINUTES=30

# E-mail (código de acesso e recuperação de senha): mail | smtp | log
MAIL_DRIVER=mail
MAIL_FROM=no-reply@admoema.com.br
MAIL_FROM_NAME="Envio de Mídias ADMoema"
SMTP_HOST=
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=
SMTP_PASS=
SUPPORT_CONTACT=midia@admoema.com.br
