# =====================================================================
# Central de Mídia ADMoema — configuração
# Copie este arquivo para ".env" (na mesma pasta) e preencha.
# =====================================================================

# production | development (development mostra erros na tela)
APP_ENV=production
APP_NAME="Central de Mídia ADMoema"

# URL pública completa, sem barra no final
BASE_URL=https://admoema.com.br/midia

# Banco de dados (cPanel → Bancos de dados MySQL)
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# Sessão — preparado para login único com /pix e /biblio:
# todos os sistemas devem usar o MESMO nome de sessão e caminho "/".
SESSION_NAME=ADMOEMA_SID
SESSION_COOKIE_PATH=/
SESSION_COOKIE_DOMAIN=
SESSION_IDLE_MINUTES=120

# Limite de tentativas de login (por e-mail + IP) dentro da janela, em minutos
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Autocadastro de membros da igreja: máximo de cadastros por IP por hora
SIGNUP_MAX_PER_HOUR=5

# Foto de perfil: tamanho máximo em MB
PHOTO_MAX_MB=5

# LGPD — versão do termo vigente (mudar a versão exige novo aceite de todos)
TERMS_VERSION=2026.1
# Contato do encarregado de dados (exibido no termo e em "Meus dados")
DPO_CONTACT=midia@admoema.com.br

# Pasta de armazenamento (vazio = pasta "storage" do projeto)
STORAGE_PATH=

# ---------------------------------------------------------------------
# Repositório de arquivos (Fase 2)
# ---------------------------------------------------------------------
# Driver de armazenamento: local (Google Drive previsto para a Fase 5)
STORAGE_DRIVER=local

# Upload em pedaços: tamanho de cada pedaço em MB (deve caber em post_max_size do PHP)
UPLOAD_CHUNK_MB=5
# Tamanho máximo por arquivo, em MB (2048 = 2 GB)
UPLOAD_MAX_MB=2048
# Sessões de upload não concluídas expiram após (horas)
UPLOAD_SESSION_HOURS=24

# Cota de armazenamento por perfil, em GB (0 = sem limite)
QUOTA_GB_ADMIN=0
QUOTA_GB_COORDENADOR=20
QUOTA_GB_MEMBRO_MIDIA=20
QUOTA_GB_LIDER_MINISTERIO=2
QUOTA_GB_PASTOR=2
QUOTA_GB_MEMBRO_IGREJA=2

# Alerta no painel quando o total armazenado passar de (GB)
STORAGE_ALERT_GB=40

# Página pública /enviar (convidados)
GUEST_MAX_FILES_PER_HOUR=30
GUEST_MAX_MB_PER_DAY=500
GUEST_MAX_FILE_MB=500

# hCaptcha na página pública (opcional). Crie a conta em hcaptcha.com
HCAPTCHA_ENABLED=0
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# Retenção (dias): rejeitados apagados e lixeira esvaziada pelo cron
RETENTION_REJECTED_DAYS=7
RETENTION_TRASH_DAYS=30

# ---------------------------------------------------------------------
# Eventos e escala (Fase 3)
# ---------------------------------------------------------------------
# Até quantas semanas à frente os cultos recorrentes são gerados (cron/diário)
SCHEDULE_WEEKS_AHEAD=8
# Alerta de sobrecarga: escalas por pessoa nos últimos 30 dias
SCHEDULE_OVERLOAD_PER_MONTH=4
# Janela de rodízio justo (dias) usada na sugestão automática
SCHEDULE_ROTATION_DAYS=60

# ---------------------------------------------------------------------
# Pedidos de arte e comunicação (Fase 4)
# ---------------------------------------------------------------------
# Prazo mínimo (dias) entre o pedido e a data de publicação; abaixo disso o pedido é marcado "urgente"
ART_MIN_DAYS=10
# Formatos que exigem aprovação pastoral (story, feed, telao, impresso), separados por vírgula
ART_PASTORAL_FORMATS=impresso,telao

# ---------------------------------------------------------------------
# E-mail (recuperação de senha)
# ---------------------------------------------------------------------
# mail  = função mail() do PHP (funciona no HostGator sem configurar nada)
# smtp  = conta de e-mail do cPanel via SMTP (mais confiável para chegar na caixa de entrada)
# log   = não envia; grava o e-mail em storage/logs (para testes)
MAIL_DRIVER=mail
MAIL_FROM=midia@admoema.com.br
MAIL_FROM_NAME="Central de Mídia ADMoema"
# Só para MAIL_DRIVER=smtp (cPanel → Contas de e-mail → Conectar dispositivos)
SMTP_HOST=mail.admoema.com.br
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=midia@admoema.com.br
SMTP_PASS=
# Validade do link de redefinição (minutos)
PASSWORD_RESET_MINUTES=60
