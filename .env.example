# =====================================================================
# Central de Mídia ADMoema — configuração
# Copie este arquivo para ".env" (na mesma pasta) e preencha.
# =====================================================================

# production | development (development mostra erros na tela)
APP_ENV=production
APP_NAME="Central de Mídia ADMoema"

# URL pública completa, sem barra no final
BASE_URL=https://admoema.com.br/midia

# Banco de dados (cPanel → Bancos de dados MySQL)
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# Sessão — preparado para login único com /pix e /biblio:
# todos os sistemas devem usar o MESMO nome de sessão e caminho "/".
SESSION_NAME=ADMOEMA_SID
SESSION_COOKIE_PATH=/
SESSION_COOKIE_DOMAIN=
SESSION_IDLE_MINUTES=120

# Limite de tentativas de login (por e-mail + IP) dentro da janela, em minutos
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Autocadastro de membros da igreja: máximo de cadastros por IP por hora
SIGNUP_MAX_PER_HOUR=5

# Foto de perfil: tamanho máximo em MB
PHOTO_MAX_MB=5

# LGPD — versão do termo vigente (mudar a versão exige novo aceite de todos)
TERMS_VERSION=2026.1
# Contato do encarregado de dados (exibido no termo e em "Meus dados")
DPO_CONTACT=midia@admoema.com.br

# Pasta de armazenamento (vazio = pasta "storage" do projeto)
STORAGE_PATH=
