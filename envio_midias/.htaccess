# Envio de Mídias ADMoema — URLs amigáveis e proteção das pastas internas
Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Se as URLs amigáveis não funcionarem na sua hospedagem, descomente a linha abaixo (ajuste a pasta se for outra):
    # RewriteBase /envio_midias/

    # Pastas internas nunca são servidas diretamente
    RewriteRule ^(app|storage|sql|cron)(/|$) - [F,L]

    # Arquivos reais (assets) são servidos normalmente; o resto vai para o roteador
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "(^\.|\.(env|sql|log|md|ini|example|lock)$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
