Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Se o roteamento falhar na subpasta, descomente e ajuste:
    # RewriteBase /midia/
    # Subpastas com sistema próprio (ex.: envio_midias) não passam pelo roteador da Central
    RewriteRule ^(envio_midias)(/|$) - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "(^\.|\.(env|sql|log|md|ini|example)$|^paths\.php$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
