{
  "name": "Central de Mídia — avisos (saída para WhatsApp)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "midia-avisos",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a1",
      "name": "Webhook midia-avisos",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "midia-avisos"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.headers['x-webhook-secret'] }}",
              "rightValue": "COLOQUE_AQUI_O_MESMO_N8N_WEBHOOK_SECRET_DO_ENV",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a2",
      "name": "Segredo confere?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "jsCode": "// Um item por destinatário, com o texto pronto vindo do sistema\nconst body = $input.first().json.body;\nreturn (body.recipients || []).map(r => ({ json: { number: r.whatsapp, name: r.name, text: body.message, event: body.event, id: body.id } }));"
      },
      "id": "a3",
      "name": "Um item por destinatário",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, -80]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://SUA-EVOLUTION-API/message/sendText/SUA_INSTANCIA",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "SUA_APIKEY_DA_EVOLUTION" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.number, text: $json.text, delay: 1200 }) }}",
        "options": { "batching": { "batch": { "batchSize": 1, "batchInterval": 1500 } } }
      },
      "id": "a4",
      "name": "Evolution API: sendText",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, -80]
    }
  ],
  "connections": {
    "Webhook midia-avisos": { "main": [[{ "node": "Segredo confere?", "type": "main", "index": 0 }]] },
    "Segredo confere?": { "main": [[{ "node": "Um item por destinatário", "type": "main", "index": 0 }], []] },
    "Um item por destinatário": { "main": [[{ "node": "Evolution API: sendText", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
